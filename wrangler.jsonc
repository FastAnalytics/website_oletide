{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-oletide",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  }
}
